# ---------------------------------------------------------------------------
# Frontend environment variables (Vite)
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Copy this file to `.env` and adjust. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Base origin of the backend API, WITHOUT a trailing slash and WITHOUT "/api".
#
# Local development: leave this EMPTY. Requests then go to "/api/..." on the Vite
# dev server, which proxies them to http://localhost:4000 (see vite.config.ts).
#
# Production (Vercel): set it to the deployed backend origin, e.g.
#   VITE_API_URL=https://erp-crm-backend.onrender.com
VITE_API_URL=
