# ---------------------------------------------------------------------------
# Backend environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Port the API listens on. Render injects its own PORT in production.
PORT=4000

# PostgreSQL connection string.
# Local:  postgresql://postgres:password@localhost:5432/pern_erp
# Neon:   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#
# NOTE for Neon: use the DIRECT endpoint, not the pooled one. Neon's pooled
# host contains "-pooler" in the hostname; remove that segment.
#   pooled  ep-name-12345678-pooler.region.aws.neon.tech   <- do not use
#   direct  ep-name-12345678.region.aws.neon.tech          <- use this
# The pooler runs PgBouncer in transaction mode, which is a poor fit for the
# interactive transaction that reserves inventory (it holds SELECT ... FOR
# UPDATE row locks across several statements) and cannot run migrations at all.
DATABASE_URL=postgresql://postgres:password@localhost:5432/pern_erp

# Separate database used by `npm test`. The test harness truncates every table
# between files, so this must NEVER point at a database you care about.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/pern_erp_test

# Secret used to sign JWTs. Minimum 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173

# bcrypt cost factor (10 is a good default).
BCRYPT_SALT_ROUNDS=10
